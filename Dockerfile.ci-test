# syntax=docker/dockerfile:1

FROM alpine:latest

RUN apk add --no-cache \
    autoconf \
    automake \
    bash \
    cmocka-dev \
    curl-dev \
    gcovr \
    gcc \
    git \
    libtool \
    make \
    musl-dev \
    openssl-dev \
    pkgconfig \
    python3

ARG NGTCP2_REF=v1.12.0

COPY tools/fetch_c_log.sh tools/c-log.ref /tmp/c-log-fetch/
RUN /tmp/c-log-fetch/fetch_c_log.sh /opt/c-log && rm -rf /tmp/c-log-fetch

RUN git clone --depth 1 --branch "${NGTCP2_REF}" https://github.com/ngtcp2/ngtcp2 /tmp/ngtcp2 \
    && cd /tmp/ngtcp2 \
    && autoreconf -fi \
    && ./configure --enable-lib-only --with-openssl \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/ngtcp2

ENV C_LOG_PATH=/opt/c-log
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/usr/lib/pkgconfig
ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /work

CMD ["sh"]
