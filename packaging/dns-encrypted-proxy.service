# Shipped disabled: the package never enables or starts it. Enable with
#   systemctl enable --now dns-encrypted-proxy
[Unit]
Description=Encrypted DNS forward proxy (classic DNS in, DoH/DoT out)
Documentation=file:///usr/share/doc/dns-encrypted-proxy/Manual.md
After=network.target
Wants=nss-lookup.target
Before=nss-lookup.target

[Service]
# The proxy implements sd_notify itself: READY=1 once the DNS listeners are
# bound (not when an upstream answers, so a WAN-down boot still starts),
# STOPPING=1 on SIGTERM.
Type=notify
ExecStart=/usr/sbin/dns-encrypted-proxy /etc/dns-encrypted-proxy/dns-encrypted-proxy.conf
# SIGHUP drops and redials every pooled upstream connection; a WAN failover
# daemon can call `systemctl reload dns-encrypted-proxy` when the route moves.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# AF_UNIX carries the sd_notify datagram and the report_socket records;
# AF_NETLINK is what getaddrinfo uses for AI_ADDRCONFIG; AF_INET6 because the
# system resolver may return v6 candidates even though the proxy dials v4.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
